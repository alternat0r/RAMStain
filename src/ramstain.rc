#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_RAMSTAIN ICON "RAMstain.ico"

// Embedded WinPmem imager (signed, Apache 2.0) and its license text.
// Paths are relative to this .rc file (src/).
IDR_WINPMEM         RCDATA "../third_party/winpmem/winpmem_x64.exe"
IDR_WINPMEM_LICENSE RCDATA "../third_party/winpmem/LICENSE"

1 VERSIONINFO
FILEVERSION     RAMSTAIN_VER_MAJOR,RAMSTAIN_VER_MINOR,RAMSTAIN_VER_PATCH,0
PRODUCTVERSION  RAMSTAIN_VER_MAJOR,RAMSTAIN_VER_MINOR,RAMSTAIN_VER_PATCH,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RAMstain"
            VALUE "FileDescription",  "RAMstain - Compact Physical Memory Capture"
            VALUE "FileVersion",      RAMSTAIN_VER_STR4
            VALUE "InternalName",     "RAMstain"
            VALUE "LegalCopyright",   "Copyright (c) 2026 RAMstain contributors. MIT License."
            VALUE "OriginalFilename", "RAMstain.exe"
            VALUE "ProductName",      "RAMstain"
            VALUE "ProductVersion",   RAMSTAIN_VER_STR4
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
