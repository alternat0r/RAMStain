#include <windows.h>
#include "resource.h"

IDI_RAMSTAIN ICON "RAMstain.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RAMstain"
            VALUE "FileDescription",  "RAMstain - Compact Physical Memory Capture"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "RAMstain"
            VALUE "LegalCopyright",   "RAMstain"
            VALUE "OriginalFilename", "RAMstain.exe"
            VALUE "ProductName",      "RAMstain"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
